[Unit]
Description=MacBook Pro 11,3 speaker crossover (tweeters + woofers)
After=pipewire.service wireplumber.service pipewire-pulse.service
BindsTo=pipewire.service
# Only on a kernel with the speaker patch; on any other kernel the plain stereo output keeps working untouched.
ConditionPathExists=/sys/module/snd_hda_codec_cs420x/parameters/split_speakers

[Service]
Type=simple
ExecCondition=%h/.local/bin/mbp-speakers check
ExecStart=%h/.local/bin/mbp-speakers run
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=pipewire.service
